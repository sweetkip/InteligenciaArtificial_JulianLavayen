        <effect id="th_s11-effect" name="th_s11">
            <profile_COMMON>
                <newparam sid="Texture_5_CMP-image_surface">
                    <surface type="2D">
                        <init_from>Texture_5_CMP-image</init_from>
                    </surface>
                </newparam>
                <newparam sid="Texture_5_CMP-image_sampler">
                    <sampler2D>
                        <source>Texture_5_CMP-image_surface</source>
                        <wrap_s>CLAMP</wrap_s>
                        <wrap_t>CLAMP</wrap_t>
                    </sampler2D>
                </newparam>
                <technique sid="standard">
                    <phong>
                        <emission>
                            <color sid="emission">0 0 0 1</color>
                        </emission>
                        <ambient>
                            <color sid="ambient">0 0 0 1</color>
                        </ambient>
                        <diffuse>
                            <texture texture="Texture_5_CMP-image_sampler" texcoord="CHANNEL0" />
                        </diffuse>
                        <specular>
                            <color sid="specular">0.227451 0.5137255 0.07058824 0.4352941</color>
                        </specular>
                        <reflective>
                            <color sid="reflective">1 1 1 1</color>
                        </reflective>
                        <shininess>
                            <float sid="shininess">50</float>
                        </shininess>
                        <reflectivity>
                            <float sid="reflectivity">1</float>
                        </reflectivity>
                        <transparency>
